# GiX-Coder Environment Variables Template
# Copy to .env.local and fill in values
# NEVER commit .env.local or any file with real secrets

# =============================================================================
# SERVICE PORTS (Local Development)
# =============================================================================
GIX_GATEWAY_HTTP_PORT=8080
GIX_GATEWAY_GRPC_PORT=9090
GIX_WORKFLOW_HTTP_PORT=8081
GIX_WORKFLOW_GRPC_PORT=9091
GIX_HARNESS_HTTP_PORT=8082
GIX_HARNESS_GRPC_PORT=9092
GIX_SANDBOX_HTTP_PORT=8083
GIX_SANDBOX_GRPC_PORT=9093
GIX_ROUTER_HTTP_PORT=8084
GIX_ROUTER_GRPC_PORT=9094
GIX_POLICY_HTTP_PORT=8085
GIX_POLICY_GRPC_PORT=9095
GIX_AUDIT_HTTP_PORT=8086
GIX_AUDIT_GRPC_PORT=9096

# =============================================================================
# DEPENDENCIES (Local Development - use docker-compose defaults)
# =============================================================================
# PostgreSQL
GIX_POSTGRES_HOST=localhost
GIX_POSTGRES_PORT=5432
GIX_POSTGRES_DATABASE=gix_coder
GIX_POSTGRES_USER=gix_coder
# GIX_POSTGRES_PASSWORD= (from secret manager)

# Redis
GIX_REDIS_HOST=localhost
GIX_REDIS_PORT=6379
# GIX_REDIS_PASSWORD= (from secret manager)

# Temporal
GIX_TEMPORAL_ADDRESS=localhost:7233
GIX_TEMPORAL_NAMESPACE=gix-coder

# Vault
GIX_VAULT_ADDRESS=http://localhost:8200
# GIX_VAULT_TOKEN= (from secret manager)

# =============================================================================
# EXTERNAL SERVICES (Use staging endpoints for dev/stage)
# =============================================================================
# GitHub
# GIX_GITHUB_APP_ID= (from secret manager)
# GIX_GITHUB_PRIVATE_KEY= (from secret manager)
# GIX_GITHUB_WEBHOOK_SECRET= (from secret manager)

# Model Providers
# GIX_OPENAI_API_KEY= (from secret manager)
# GIX_ANTHROPIC_API_KEY= (from secret manager)
# GIX_OLLAMA_HOST=http://localhost:11434

# MCP Registry
# GIX_MCP_REGISTRY_URL=https://registry.mcp.example.com
# GIX_MCP_API_KEY= (from secret manager)

# =============================================================================
# AUTHENTICATION & AUTHORIZATION
# =============================================================================
# JWT
# GIX_JWT_SIGNING_KEY= (from secret manager - RSA private key)
# GIX_JWT_VERIFICATION_KEY= (from secret manager - RSA public key)
# GIX_JWT_ISSUER=gix-coder
# GIX_JWT_AUDIENCE=gix-coder-api

# OIDC (Optional)
# GIX_OIDC_ISSUER=https://auth.example.com
# GIX_OIDC_CLIENT_ID= (from secret manager)
# GIX_OIDC_CLIENT_SECRET= (from secret manager)

# =============================================================================
# FEATURE FLAGS
# =============================================================================
GIX_GATEWAY_NEW_ROUTING=false
GIX_GATEWAY_ENHANCED_AUTH=true
GIX_SANDBOX_FIRECRACKER_ENABLED=false
GIX_ROUTER_ML_CLASSIFIER=false
GIX_HARNESS_CHECKPOINTING=true

# =============================================================================
# OBSERVABILITY
# =============================================================================
GIX_LOG_LEVEL=debug
GIX_LOG_FORMAT=console
GIX_TRACING_ENABLED=true
GIX_TRACING_SAMPLER=parentbased_traceidratio
GIX_TRACING_RATIO=1.0
GIX_METRICS_ENABLED=true
GIX_METRICS_PORT=9090

# =============================================================================
# SANDBOX CONFIGURATION
# =============================================================================
GIX_SANDBOX_RUNTIME=gvisor
GIX_SANDBOX_DEFAULT_CPU_LIMIT=1000m
GIX_SANDBOX_DEFAULT_MEMORY_LIMIT=512Mi
GIX_SANDBOX_DEFAULT_TIMEOUT=300s
GIX_SANDBOX_MAX_CONCURRENT=100

# =============================================================================
# ROUTER CONFIGURATION
# =============================================================================
GIX_ROUTER_DEFAULT_MODEL=gpt-4o-mini
GIX_ROUTER_MAX_TOKENS_PER_REQUEST=32000
GIX_ROUTER_COST_OPTIMIZATION=true

# =============================================================================
# POLICY CONFIGURATION
# =============================================================================
GIX_POLICY_ENGINE=opa
GIX_POLICY_BUNDLE_PATH=/policies
GIX_POLICY_CACHE_TTL=60s

# =============================================================================
# DEVELOPMENT OVERRIDES
# =============================================================================
# Set to true to enable debug endpoints
GIX_DEBUG_ENDPOINTS=true

# Set to true to disable TLS in development
GIX_TLS_DISABLED=true

# =============================================================================
# SECRET MANAGER REFERENCES (for local development with 1Password CLI)
# =============================================================================
# Example: op://vault/gateway/github-token
# GIX_GATEWAY_GITHUB_TOKEN=op://vault/gateway/github-token
# GIX_GATEWAY_JWT_KEY=op://vault/gateway/jwt-key
# GIX_SANDBOX_TLS_CERT=op://vault/sandbox/tls-cert
# GIX_SANDBOX_TLS_KEY=op://vault/sandbox/tls-key